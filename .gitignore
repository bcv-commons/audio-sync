# Claude local context (not committed)
CLAUDE.local.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*

# Per-machine config with real local values (hw tuning, device/chunk-size
# settings, etc.) that's genuinely useful as a documented template for
# anyone deploying this pipeline elsewhere — see conf/hw.local.json.example.
# Glob-based so a *new* file following this naming convention is
# automatically excluded without needing a new .gitignore line each time.
conf/*.local.*

# Local scratch/investigation notes (crash forensics, capacity planning) —
# MONO owns the canonical internal-docs/ convention for this project;
# this repo's copy is working notes for this machine, not for the repo's
# committed history.
internal-docs/

# Legacy/specialized scripts kept locally for reference, not maintained
# as part of the current pipeline.
scripts-bak/

# Linux/CUDA/systemd-specific operational scripts (nvidia-smi, journalctl,
# SysRq, sudoers-dependent GPU-wedge recovery) — this box's own tooling,
# not portable across the macOS/Linux split the rest of the pipeline
# supports. Keep scripts/ cross-platform (ssh/rsync/rclone only).
internal-scripts/

# Batch manifests (fetched/hand-crafted locally)
_batches/
_obs_batches/
_runs/
_obs_runs/

# Downloaded/generated audio, text, and alignment output (runtime data)
downloads/
sorted/
export/
word-timing-data/
api-cache/
download_log/

# OS cruft
.DS_Store

contrib
josh
spotcheck
hays_audio/

# Bulk source-audio downloads staged at repo root (e.g. openbible.com's
# BSB_00_Chapters_Hays.zip) — working data, not source.
*.zip

# Installer packages downloaded during machine setup (e.g. cuda-keyring),
# not source.
*.deb
